APP_NAME=LIGHT_HRMS BACKEND
APP_ENV=dev
DEBUG=True
API_V1_PREFIX=/api/v1
# For host runs (uv run start.py) the database is on localhost. When the app
# runs as the compose `app` service, compose.yml overrides this to host `db`
# -- you do not need to change this value for either mode.
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/light_hrms_db
LOG_LEVEL=INFO
